# Copia este fichero como .env para cambiar algún valor. Todas las variables son opcionales.

# Zona horaria del pueblo para «abierto ahora» y las temporadas (D-011).
ZONA_HORARIA=Europe/Madrid

# Modelo local de Ollama para el generador opcional (make up-llm, D-048). Más pequeño y rápido: qwen2.5:1.5b.
LLM_MODELO=qwen2.5:3b
